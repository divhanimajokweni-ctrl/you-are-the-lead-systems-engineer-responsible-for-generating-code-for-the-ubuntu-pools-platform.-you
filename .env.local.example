# Database
# Get this from your PostgreSQL provider (e.g., Neon, Supabase, Railway)
DATABASE_URL=postgresql://postgres:[j8dfx95WVqmmEieB]@db.juuzzazslpbdbouclwbf.supabase.co:5432/postgres

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Socket.io (for WebSocket connections)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Stitch (get from https://dashboard.stitch.com/developers/keys)
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_ENV=sandbox
STITCH_REDIRECT_URI=http://localhost:3000/api/stitch/callback

# Bank Provider (default: stitch)
BANK_PROVIDER=stitch

# Observability
NEXT_PUBLIC_METRICS_ENABLED=true

# OpenClaw Integration (Executive Shadow)
# Set to 'true' to enable OpenClaw notifications
OPENCLAW_ENABLED=false
# Your OpenClaw Gateway URL (default: http://localhost:18789)
OPENCLAW_GATEWAY_URL=http://localhost:18789
# API key for OpenClaw Gateway (generate in OpenClaw dashboard)
OPENCLAW_API_KEY=
