# Database
# Get this from your PostgreSQL provider (e.g., Neon, Supabase, Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/ubuntu_pools

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Socket.io (for WebSocket connections)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Plaid (get from https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,auth
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=

# Observability
NEXT_PUBLIC_METRICS_ENABLED=true
